<lccdd>

    <define>
        <comment>
            ### B0 Tracker Parameters
        </comment>

        <comment>
            Four AC-LGAD tracking layers inside the B0 magnet. Layer positions are
            relative to B0TrackerCenter_zpos and are kept explicit for placement scans.
        </comment>

        <constant name="B0TrackerCenter_zpos"    value="6063.525026*mm"/>
        <constant name="B0TrackerCenter_xpos"    value="-0.16000052*m" />
        <constant name="B0Tracker_rotation"      value="ionCrossingAngle" />

        <constant name="B0TrackerLayer1_zstart"  value="0*mm"/>
        <constant name="B0TrackerLayer2_zstart"  value="278.687085*mm"/>
        <constant name="B0TrackerLayer3_zstart"  value="537.668013*mm"/>
        <constant name="B0TrackerLayer4_zstart"  value="780.243813*mm"/>

        <comment>
            Basic tracking unit geometry. Materials below are effective compact
            material names used by simulation; dimensions and materials are kept
            explicit for B0 layout/material-budget updates.
        </comment>

        <constant name="B0TrackerPCBThickness"      value="2.0*mm" />
        <constant name="B0TrackerSensorThickness"   value="0.3*mm" />
        <constant name="B0TrackerASICThickness"     value="0.3*mm" />

        <constant name="B0TrackerPCBWidth"          value="2.54*cm" />
        <constant name="B0TrackerPCBLength"         value="4.6*cm" />

        <constant name="B0TrackerSensorWidth"       value="1.6*cm" />
        <constant name="B0TrackerSensorLength"      value="1.6*cm" />
        <constant name="B0TrackerSensorOverlap"     value="1.0*mm" />

        <constant name="B0TrackerASICWidth"         value="1.6*cm" />
        <constant name="B0TrackerASICLength"        value="1.6*cm" />
        <constant name="B0TrackerASICOverlap"       value="1.0*mm" />

        <!-- Support: annular sector (half-disk with inner hole) -->
        <constant name="B0TrackerSupportRMin"       value="3.5*cm" />
        <constant name="B0TrackerSupportRMax"       value="15.0*cm" />
        <constant name="B0TrackerSupportThickness"  value="4.0*mm" />
        <constant name="B0TrackerSupportPhiStart"   value="90*deg" />
        <constant name="B0TrackerSupportPhiDelta"   value="180*deg" />

        <constant name="B0TrackerModuleThickness"
        value="B0TrackerPCBThickness + 2*(B0TrackerASICThickness + B0TrackerSensorThickness)" />

        <!-- Centre-to-centre offset between support disc and module stack -->
        <constant name="B0TrackerModuleOffsetFromSupport"
        value="(B0TrackerSupportThickness + B0TrackerModuleThickness)/2" />

        <!-- ACTS material-map binning copied to each front/back B0 tracking layer. -->
        <constant name="B0TrackerLayerMaterialPhiBins" value="30" />
        <constant name="B0TrackerLayerMaterialRBins"   value="20" />

    </define>

    <!-- ================================================================== -->
    <!-- Tracking module definition                                         -->
    <!-- ================================================================== -->

    <module name="TrackingUnit" vis="TrackingModule">
        <module_component name="PCB" material="Copper" vis="PCBVis">
            <box x="B0TrackerPCBWidth" y="B0TrackerPCBLength" z="B0TrackerPCBThickness" />
            <position x="0.0*cm" y="0.0*cm" z="0.0*cm" />
        </module_component>

        <module_component name="ASIC1" material="SiliconOxide" vis="ASICVis">
            <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerASICLength)/2"
            z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness/2)" />
        </module_component>

        <module_component name="ASIC2" material="SiliconOxide" vis="ASICVis">
            <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerASICLength)/2 + B0TrackerASICLength-B0TrackerASICOverlap"
            z="B0TrackerPCBThickness/2+B0TrackerASICThickness/2" />
        </module_component>

        <module_component name="ASIC3" material="SiliconOxide" vis="ASICVis">
            <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerASICLength)/2 + 2*(B0TrackerASICLength-B0TrackerASICOverlap)"
            z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness/2)" />
        </module_component>

        <module_component name="Sensor1" material="SiliconOxide" vis="SensorVis" sensitive="true">
            <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2"
            z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2)" />
        </module_component>

        <module_component name="Sensor2" material="SiliconOxide" vis="SensorVis" sensitive="true">
            <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2 + B0TrackerSensorLength-B0TrackerSensorOverlap"
            z="(B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2)" />
        </module_component>

        <module_component name="Sensor3" material="SiliconOxide" vis="SensorVis" sensitive="true">
            <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness" />
            <position x="0.0*cm"
            y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2 + 2*(B0TrackerSensorLength-B0TrackerSensorOverlap)"
            z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2)" />
        </module_component>
    </module>

    <module name="B0SupportDisk" vis="B0SupportDiscVis">
      <module_component name="support" material="Copper">
        <tube rmin="B0TrackerSupportRMin"
              rmax="B0TrackerSupportRMax"
              dz="B0TrackerSupportThickness/2"
              startphi="B0TrackerSupportPhiStart"
              deltaphi="B0TrackerSupportPhiDelta"/>
      </module_component>
    </module>

    <!-- ================================================================== -->
    <!-- Empty negative-endcap companion used by B0TrackerSubAssembly so     -->
    <!-- ACTS sees B0 as a positive-only member of a two-endcap hierarchy.    -->
    <!-- ================================================================== -->

    <detectors>

        <detector id="B0TrackerCompanion_ID"
            name="B0TrackerCompanion"
            type="epic_CompositeTracker"
            actsType="endcap"
            vis="TrackerSubAssemblyVis">
            <type_flags type="DetType_TRACKER + DetType_ENDCAP" />
            <position x="0*cm" y="0*cm" z="-4*um" />
        </detector>

